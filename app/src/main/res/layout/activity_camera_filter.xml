<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".CameraFilterActivity">

    <!-- ========== 顶部：当前滤镜名 + 倒计时 ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/tv_filter_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="原图"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_record_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF4444"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ========== 预览区（占据主要空间）========== -->
    <com.dawn.filter.CameraFilterView
        android:id="@+id/camera_filter_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ========== Tab 切换栏 ========== -->
    <LinearLayout
        android:id="@+id/layout_tabs"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="#1A000000">

        <TextView
            android:id="@+id/tab_filter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="滤镜"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/tab_beauty"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="美颜"
            android:textColor="#88FFFFFF"
            android:textSize="15sp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/tab_setting"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="设置"
            android:textColor="#88FFFFFF"
            android:textSize="15sp"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <!-- ========== Tab 指示器 ========== -->
    <View
        android:id="@+id/tab_indicator"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="#FFFFFF" />

    <!-- ========== Tab 面板容器 ========== -->
    <FrameLayout
        android:id="@+id/layout_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="130dp"
        android:background="#F8000000">

        <!-- ===== 面板 1：滤镜 ===== -->
        <LinearLayout
            android:id="@+id/panel_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="wrap_content"
                    android:text="强度"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seekbar_intensity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingHorizontal="6dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_filters"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:clipToPadding="false"
                android:paddingHorizontal="6dp" />
        </LinearLayout>

        <!-- ===== 面板 2：美颜 ===== -->
        <LinearLayout
            android:id="@+id/panel_beauty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView android:layout_width="42dp" android:layout_height="wrap_content"
                    android:text="磨皮" android:textColor="#CCCCCC" android:textSize="13sp" />
                <SeekBar android:id="@+id/seekbar_smoothness"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:paddingHorizontal="6dp" />

                <TextView android:layout_width="42dp" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="美白" android:textColor="#CCCCCC" android:textSize="13sp" />
                <SeekBar android:id="@+id/seekbar_whiten"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:paddingHorizontal="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView android:layout_width="42dp" android:layout_height="wrap_content"
                    android:text="红润" android:textColor="#CCCCCC" android:textSize="13sp" />
                <SeekBar android:id="@+id/seekbar_rosy"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:paddingHorizontal="6dp" />

                <TextView android:layout_width="42dp" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="亮度" android:textColor="#CCCCCC" android:textSize="13sp" />
                <SeekBar android:id="@+id/seekbar_beauty_brightness"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:paddingHorizontal="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView android:layout_width="42dp" android:layout_height="wrap_content"
                    android:text="对比" android:textColor="#CCCCCC" android:textSize="13sp" />
                <SeekBar android:id="@+id/seekbar_beauty_contrast"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:paddingHorizontal="6dp" />

                <TextView android:layout_width="42dp" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="伽马" android:textColor="#CCCCCC" android:textSize="13sp" />
                <SeekBar android:id="@+id/seekbar_beauty_gamma"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:paddingHorizontal="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView android:layout_width="42dp" android:layout_height="wrap_content"
                    android:text="饱和" android:textColor="#CCCCCC" android:textSize="13sp" />
                <SeekBar android:id="@+id/seekbar_beauty_saturation"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:maxWidth="240dp"
                    android:paddingHorizontal="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 面板 3：设置 ===== -->
        <LinearLayout
            android:id="@+id/panel_setting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_flip_h"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="水平镜像"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_flip_v"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="垂直翻转"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_rotate_90"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="旋转90°"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <Button
                    android:id="@+id/btn_switch_camera"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:text="切摄像头"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_record"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:text="录制"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_take_picture"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:text="拍照"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_video_list"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:text="视频"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
