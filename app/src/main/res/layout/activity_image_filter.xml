<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ImageFilterActivity">

    <!-- ========== 顶部操作栏 ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <Button
            android:id="@+id/btn_pick_image"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="选择图片"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_filter_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="原图"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="保存"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ========== 图片预览区（占据主要空间）========== -->
    <jp.co.cyberagent.android.gpuimage.GPUImageView
        android:id="@+id/gpu_image_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ========== Tab 切换栏 ========== -->
    <LinearLayout
        android:id="@+id/layout_tabs"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="#1A000000">

        <TextView
            android:id="@+id/tab_filter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="滤镜"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/tab_beauty"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="美颜"
            android:textColor="#88FFFFFF"
            android:textSize="15sp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/tab_setting"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="设置"
            android:textColor="#88FFFFFF"
            android:textSize="15sp"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <!-- ========== Tab 指示器 ========== -->
    <View
        android:id="@+id/tab_indicator"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="#FFFFFF" />

    <!-- ========== Tab 面板容器 ========== -->
    <FrameLayout
        android:id="@+id/layout_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="130dp"
        android:background="#F8000000">

        <!-- ===== 面板 1：滤镜 ===== -->
        <LinearLayout
            android:id="@+id/panel_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="wrap_content"
                    android:text="强度"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seekbar_intensity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingHorizontal="6dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_filters"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:clipToPadding="false"
                android:paddingHorizontal="6dp" />
        </LinearLayout>

        <!-- ===== 面板 2：美颜 ===== -->
        <LinearLayout
            android:id="@+id/panel_beauty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView android:layout_width="42dp" android:layout_height="wrap_content"
                    android:text="磨皮" android:textColor="#CCCCCC" android:textSize="13sp" />
                <SeekBar android:id="@+id/seekbar_smoothness"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:paddingHorizontal="6dp" />

                <TextView android:layout_width="42dp" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="美白" android:textColor="#CCCCCC" android:textSize="13sp" />
                <SeekBar android:id="@+id/seekbar_whiten"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:paddingHorizontal="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView android:layout_width="42dp" android:layout_height="wrap_content"
                    android:text="红润" android:textColor="#CCCCCC" android:textSize="13sp" />
                <SeekBar android:id="@+id/seekbar_rosy"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:paddingHorizontal="6dp" />

                <TextView android:layout_width="42dp" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="亮度" android:textColor="#CCCCCC" android:textSize="13sp" />
                <SeekBar android:id="@+id/seekbar_beauty_brightness"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:paddingHorizontal="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView android:layout_width="42dp" android:layout_height="wrap_content"
                    android:text="对比" android:textColor="#CCCCCC" android:textSize="13sp" />
                <SeekBar android:id="@+id/seekbar_beauty_contrast"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:paddingHorizontal="6dp" />

                <TextView android:layout_width="42dp" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="伽马" android:textColor="#CCCCCC" android:textSize="13sp" />
                <SeekBar android:id="@+id/seekbar_beauty_gamma"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:paddingHorizontal="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView android:layout_width="42dp" android:layout_height="wrap_content"
                    android:text="饱和" android:textColor="#CCCCCC" android:textSize="13sp" />
                <SeekBar android:id="@+id/seekbar_beauty_saturation"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:maxWidth="240dp"
                    android:paddingHorizontal="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 面板 3：设置 ===== -->
        <LinearLayout
            android:id="@+id/panel_setting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <Button
                    android:id="@+id/btn_pick_image_bottom"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="选图片"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_save_bottom"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="保存"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
